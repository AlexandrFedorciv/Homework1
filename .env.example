# Copy this file to .env and fill in your key. .env is git-ignored — never commit it.

# Which LLM backend to use: anthropic | openai | mock
#   mock = no API key needed, returns canned data (good for trying the app / tests)
LLM_PROVIDER=anthropic

# Anthropic (when LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=

# OpenAI or any OpenAI-compatible API (when LLM_PROVIDER=openai)
# Works with OpenAI, OpenRouter, Groq, a local Ollama server, ...
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Model name. Defaults: anthropic -> claude-sonnet-5-5. For openai you must set it.
LLM_MODEL=

# Optional tuning
LLM_TIMEOUT_MS=60000
LLM_MAX_RETRIES=3
PORT=3000
